# ===========================================
# 🔐 LIFEOS - Environment Variables
# ===========================================
# Copia questo file in .env e personalizza i valori

# Server
NODE_ENV=development
PORT=3001

# Database
MONGO_URI=mongodb://admin:password123@localhost:27017/extra-tracker?authSource=admin

# JWT Secrets (GENERA NUOVI VALORI IN PRODUZIONE!)
# Comando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME

# Frontend URL (per CORS)
FRONTEND_URL=http://localhost:5174

# Rate Limiting (opzionale)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# OpenAI
OPENAI_API_KEY=changeme-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Pinecone
PINECONE_API_KEY=changeme-pinecone-key
PINECONE_INDEX=changeme-index-name
