# Netlify/Vercel headers per compressione e caching
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block

# Compressione automatica (gestita dal server)
# Per altri server, configurare gzip/brotli nel server stesso

# Cache per assets statici
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache per HTML (più corta)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Service Worker e manifest
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.json
  Cache-Control: public, max-age=86400
